{
  "name": "vn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true && npm run --cwd apps/api build:types",
    "postinstall": "bun run --cwd apps/api bootstrap",
    "dev": "concurrently --kill-others-on-fail \"npm run --cwd apps/api dev\" \"npm run --cwd apps/pwa dev\"",
    "check": "npm run typecheck && npm run prettier && npm run lint",
    "typecheck": "bun run --filter=@vn/api typecheck && bun run --filter=@vn/pwa typecheck",
    "prettier": "prettier --check .",
    "format": "prettier --write . && oxlint --fix",
    "lint": "oxlint",
    "skill-sync": "bun scripts/skill-sync.mjs",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "push": "cd apps/api && npx drizzle-kit push",
    "reset": "cd apps/api && npx drizzle-kit reset"
  },
  "devDependencies": {
    "@testing-library/user-event": "^14.6.4",
    "@types/bun": "^1.3.14",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-istanbul": "4.1.7",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.7"
  }
}
